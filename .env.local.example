# Copia este archivo como .env.local y reemplaza cada marcador.
# Nunca guardes credenciales reales en este archivo ni en Git.

# Supabase: URL y clave pública para Auth SSR.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Formato sb_publishable_... (puede ir en el navegador).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# URL pública del entorno. En producción debe usar HTTPS y no terminar en /.
NEXT_PUBLIC_SITE_URL=https://isia-ingenieria-de-sistemas-intelig.vercel.app

# Interruptor para salir del modo DEMO. Mientras no valga exactamente "true" el sitio
# permanece noindex (meta, cabecera X-Robots-Tag, robots.txt y sitemap vacío).
# NEXT_PUBLIC_SITIO_INDEXABLE=true

# Exclusiva del servidor. Nunca uses NEXT_PUBLIC_ ni la expongas al navegador.
# Formato sb_secret_... (solo servidor, scripts y CI privados).
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# Opcionales: activan el aviso por correo de las solicitudes de participación.
# RESEND_FROM_EMAIL debe pertenecer a un dominio verificado en Resend.
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL="Sitio ISIA <notificaciones@DOMINIO_VERIFICADO_AQUI>"

# Opcionales: integración de forks de GitHub. Configura el webhook hacia
# /api/integraciones/github/webhook con Content type application/json.
GITHUB_WEBHOOK_SECRET=TU_SECRETO_ALEATORIO_AQUI
GITHUB_ALLOWED_OWNER=CUENTA_U_ORGANIZACION_GITHUB_AUTORIZADA

# Convocatorias: solo una cuenta administradora con este correo puede ajustar
# el intervalo y ejecutar "Buscar ahora". Configura el correo real en el entorno.
ISIA_INSTITUTIONAL_EMAIL=CORREO_INSTITUCIONAL_AUTORIZADO
# Secreto del programador de Vercel para /api/cron/convocatorias.
CRON_SECRET=SECRETO_ALEATORIO_LARGO
